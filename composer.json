{
    "name": "nijidigital/phpstan-rules",
    "description": "custom phpstan rules created by dsf-niji",
    "type": "phpstan-extension",
    "autoload": {
        "psr-4": {
            "NijiDigital\\PhpStanRules\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NijiDigital\\PhpStanRules\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "dsf-niji"
        }
    ],
    "config": {
        "sort-packages": true
    },
    "require": {
        "php": ">=8.2",
        "phpstan/phpstan": "^2.0",
        "psr/clock": "^1.0"
    },
    "require-dev": {
        "doctrine/migrations": "^3.9",
        "friendsofphp/php-cs-fixer": "^3.86",
        "phpstan/phpstan-deprecation-rules": "^2",
        "phpunit/phpunit": "^11.5",
        "rector/rector": "^2.1"
    },
    "extra": {
        "phpstan": {
            "includes": [
                "extension.neon"
            ]
        }
    }
}
